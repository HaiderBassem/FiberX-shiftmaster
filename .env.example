# =============================================================================
#  ____  _     _  __ _   __  __           _
# / ___|| |__ (_)/ _| |_|  \/  | __ _ ___| |_ ___ _ __
# \___ \| '_ \| | |_| __| |\/| |/ _` / __| __/ _ \ '__|
#  ___) | | | | |  _| |_| |  | | (_| \__ \ ||  __/ |
# |____/|_| |_|_|_|  \__|_|  |_|\__,_|___/\__\___|_|
#
# Example Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment:
#   cp .env.example .env
#
# Module:  shiftmaster-backend
# Stack:   Go 1.26 · Gin · PostgreSQL · Caddy
#
# Every variable below is read by internal/config/config.go. Variables the code
# does not consume are not listed. The application refuses to start on an invalid
# configuration rather than falling back to an insecure default.
# =============================================================================

# =============================================================================
#  DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# Primary connection parameters for pgx/v5 driver
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=shiftmaster
DB_SSL_MODE=disable

# ── Connection Pool Tuning ───────────────────────────────────────────────────
# Fine-tune pool behavior based on your workload.
# Uncomment and adjust as needed; defaults (shown) are applied if omitted.
#
# DB_MAX_OPEN_CONNS=50          # Maximum simultaneous open connections
# DB_MIN_CONNS=10               # Minimum idle connections kept alive
# DB_CONN_MAX_LIFETIME=3600     # Max lifetime of a connection (seconds)
# DB_CONN_MAX_IDLE_TIME=1800    # Max idle time before closing (seconds)
# DB_CONNECT_TIMEOUT=10         # Dial timeout (seconds)
# DB_QUERY_TIMEOUT=30           # Standard query timeout (seconds)
# DB_LONG_QUERY_TIMEOUT=300     # Long-running query timeout (seconds)
# DB_HEALTH_CHECK_PERIOD=60     # Health-check interval (seconds)
# DB_MAX_RETRIES=3              # Connection retry attempts
# DB_RETRY_INTERVAL_MS=100      # Delay between retries (milliseconds)

# =============================================================================
#   SERVER CONFIGURATION
# =============================================================================
# The API listens on SERVER_HOST:SERVER_PORT.
# ENV controls behavior: 'development' | 'staging' | 'production'
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENV=development

# ── HTTP Timeouts (seconds) ──────────────────────────────────────────────────
# SERVER_READ_TIMEOUT=60        # Max time to read the full request
# SERVER_WRITE_TIMEOUT=60       # Max time to write the response
# SERVER_IDLE_TIMEOUT=120       # Max keep-alive idle time

# ── App Secret ──
# Required when ENV=production. Generate with: openssl rand -hex 32
# APP_SECRET_KEY=

# =============================================================================
#  JWT & SECURITY CONFIGURATION
# =============================================================================
# REQUIRED. There is no default and no usable placeholder: the value below is
# rejected on purpose so a deployment cannot start with a secret published in
# this repository. Generate your own before the first run:
#
#     openssl rand -hex 32
#
# Rules enforced at startup (internal/config/config.go):
#   - at least 32 characters (48 in production)
#   - not a known placeholder, and not obviously low entropy
#
# Rotating this value invalidates every issued token and signs every user out.
JWT_SECRET=REPLACE_ME_RUN_openssl_rand_hex_32

# Tokens are stamped with this issuer and verified against it. Changing it
# invalidates existing tokens.
JWT_ISSUER=shiftmaster-api

# Access tokens are short-lived; refresh tokens are long-lived. The two carry a
# "typ" claim and are NOT interchangeable: a refresh token is rejected on normal
# API routes, and an access token is rejected at /api/auth/refresh.
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7

# Bcrypt work factor, 10-14. Higher is slower and stronger.
BCRYPT_COST=12

# ── Rate Limiting & Account Lockout ──────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MIN=15

# After MAX_LOGIN_ATTEMPTS consecutive failures an account is locked for
# LOCKOUT_DURATION_MIN minutes via employees.locked_until. The lock expires on
# its own and never changes employees.status, so a failed login cannot remove
# somebody from the roster. IP-level blocking uses twice this threshold.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15

# ── Trusted Proxies ─────────────────────────────────────────────────────────
# Comma-separated IPs or CIDR ranges whose X-Forwarded-For header is believed.
# Keep this as narrow as possible: the IP blocker and the login throttle both
# key off the resulting client address, so trusting an untrusted hop lets a
# caller forge it. In the standard deployment Caddy runs on the same host, so
# loopback is the correct value.
TRUSTED_PROXIES=127.0.0.1

# =============================================================================
#   CORS CONFIGURATION
# =============================================================================
# CORS_ALLOWED_ORIGINS is also the allowlist for WebSocket upgrades, so it must
# include the exact origin the SPA is served from (scheme, host and port all
# matter). In production set it to your real origin, e.g.
#   CORS_ALLOWED_ORIGINS=https://shift-master.org
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,X-Department-ID
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
#   UPLOAD CONFIGURATION
# =============================================================================
# Files are stored under UPLOAD_BASE_PATH with sub-directories:
#   ./uploads/images/       — Rich-text and announcement images
#   ./uploads/profiles/     — Employee profile photos
#   ./uploads/documents/    — General documents
#   ./uploads/assignments/  — Shift assignment documents
UPLOAD_BASE_PATH=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# Image endpoints intersect this list with the formats the server can decode and
# re-encode (jpg, jpeg, png, gif). Listing a document type here does NOT make it
# acceptable to an image endpoint; uploads are validated by content, never by
# filename or declared Content-Type.
UPLOAD_ALLOWED_TYPES=png,jpg,jpeg,gif,pdf,doc,docx

# =============================================================================
#   LOGGING CONFIGURATION
# =============================================================================
# LOG_LEVEL  — Verbosity: 'debug' | 'info' | 'warn' | 'error'
# LOG_FORMAT — Output format: 'json' (structured) | 'text' (human-readable)
LOG_LEVEL=debug
LOG_FORMAT=json

# =============================================================================
#   EMAIL (Microsoft Graph API)
# =============================================================================
# Outbound email goes through Microsoft Graph, not SMTP. Leave these blank to
# disable email; the application starts normally and simply does not send.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=support@fiberx.iq

# =============================================================================
#   WEB PUSH (VAPID)
# =============================================================================
# Required for browser push notifications. Leave blank to disable push; in-app
# and WebSocket notifications continue to work without it.
# Generate a key pair with any VAPID tool, e.g.:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fiberx.iq

# =============================================================================
#   AI ASSISTANT
# =============================================================================
# The Home-page AI assistant. Leave ASSISTANT_API_KEY blank to disable it —
# the endpoints report themselves unavailable and the frontend hides the
# panel; nothing else in the application changes. ANTHROPIC_API_KEY is
# accepted as a fallback name for the same value.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
# ASSISTANT_BASE_URL=https://api.anthropic.com
# Cost and abuse limits (defaults shown).
# ASSISTANT_MAX_TOKENS=1500
# ASSISTANT_TIMEOUT_SECONDS=45
# ASSISTANT_MAX_RETRIES=2
# ASSISTANT_REQUESTS_PER_MINUTE=8
# ASSISTANT_MAX_TOOL_ROUNDS=6
# ASSISTANT_MAX_INPUT_CHARS=4000
# ASSISTANT_MAX_CONTEXT_MESSAGES=24
# ASSISTANT_MAX_CONVERSATION_MESSAGES=200
# ASSISTANT_PENDING_ACTION_TTL_SECONDS=300

# =============================================================================
#   FRONTEND (frontend/.env)
# =============================================================================
# These belong in frontend/.env, not this file. Vite only exposes VITE_* names.
#
#   VITE_API_URL=/api
#
# Leave VITE_API_URL unset in production so the SPA calls the same origin it was
# served from and Caddy proxies /api to this service.
