[Unit]
Description=ShiftMaster API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=techsupport
Group=techsupport
WorkingDirectory=/opt/shiftmaster
EnvironmentFile=/opt/shiftmaster/.env
ExecStart=/opt/shiftmaster/shiftmaster-api
Restart=always
RestartSec=5
StandardOutput=append:/var/log/shiftmaster/api.log
StandardError=append:/var/log/shiftmaster/api-error.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/shiftmaster/uploads /var/log/shiftmaster

# Uploaded files are served only to authenticated users, so nothing the service
# writes should be readable by other accounts on the host.
UMask=0027

PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# The API only needs to speak IP; denying other families removes a large slice
# of kernel attack surface.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
