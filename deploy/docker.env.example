# Environment for docker compose. Copy to .env.docker in the repository root:
#
#     cp deploy/docker.env.example .env.docker
#
# .env.docker is gitignored. It is read by every service, so the database
# credentials are written once and both Postgres and the API follow them.
#
# This file is deliberately short. The image already sets what the container
# decides (listen address, upload path, ENV, log format), and everything the
# application does not need has a working default in internal/config. Add a line
# here only when you are changing one of those.

# ── Database ─────────────────────────────────────────────────────────────────
# The first pair is what Postgres creates on an empty volume; the second is what
# the API connects with. They must agree. DB_HOST is set by the compose file.
POSTGRES_USER=shiftmaster
POSTGRES_PASSWORD=change-me-before-you-deploy
POSTGRES_DB=shiftmaster

DB_USER=shiftmaster
DB_PASSWORD=change-me-before-you-deploy
DB_NAME=shiftmaster
DB_PORT=5432
DB_SSL_MODE=disable

# ── Secrets ──────────────────────────────────────────────────────────────────
# Both are REQUIRED. Generate a separate value for each:
#
#     openssl rand -hex 32
#
# The images set ENV=production, and in production the API refuses to start
# without either of these — so a container that is missing one crash-loops with
# the reason in its logs rather than starting up insecurely.
#
# JWT_SECRET signs session tokens. It is also rejected if it is a known
# placeholder or shorter than 48 characters; the command above yields 64.
# Changing it signs out every session, which is exactly what you want if it
# ever leaks.
JWT_SECRET=
APP_SECRET_KEY=

# ── Origins ──────────────────────────────────────────────────────────────────
# The web container serves the app and the API from one origin, so the browser
# never makes a cross-origin call and this list can stay empty in that
# arrangement. Set it if something else fronts the API.
# CORS_ALLOWED_ORIGINS=https://shiftmaster.example.com

# ── Optional integrations ────────────────────────────────────────────────────
# Outbound mail through Microsoft Graph. Left blank, the API skips sending
# rather than failing.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER_EMAIL=

# Web push. Generate a key pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# ── Assistant ────────────────────────────────────────────────────────────────
# Only meaningful with docker-compose.ai.yml, which mounts a model and builds
# the api-ai image. Without it the assistant reports itself unavailable and no
# other part of the product is affected.
# AI_ENABLED=true
# AI_CONTEXT_SIZE=16384
# AI_PARALLEL=2
# AI_GPU_LAYERS=0
