# Caddy inside the web image: static frontend, /api reverse-proxied to the API
# container.
#
# It lives here rather than in deploy/ because a Dockerfile can only COPY from
# its own build context, and the web image is built from frontend/.
#
# The bare-metal ../Caddyfile stays the reference for a host install. This file
# differs from it in exactly three ways, all of them forced by the container:
#
#   - it proxies to the api service by name, not to 127.0.0.1;
#   - it listens on 8080 so the process can drop to a non-root user, with the
#     host publishing 80 in front of it;
#   - it logs to stdout, because a container's logs belong to the runtime and
#     not to a rolled file inside a layer.
#
# The /maps route in the bare-metal file is deliberately absent: that KMZ
# service lives outside this repository and there is nothing here to build it
# from.
{
	admin off
	# Caddy would otherwise try to be helpful about certificates. TLS belongs to
	# whatever fronts this — Cloudflare Tunnel, an ingress, a host Caddy.
	auto_https off
}

:8080 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:8080
	}

	# Same upstream as /api: the API owns its own liveness answer, so the edge
	# must not fake a healthy response while the backend is down.
	handle /health {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Credentials must never reach the log. The application authenticates from
	# the Authorization header everywhere except the WebSocket upgrade, which
	# carries a 30-second single-use ticket in the query string. Both are
	# redacted here so a captured log is worthless, and so this stays true if a
	# future change reintroduces a credential in a URL.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace ticket REDACTED
					replace token REDACTED
					replace access_token REDACTED
					replace refresh_token REDACTED
					# Signed upload URLs carry their credential in "sig".
					replace sig REDACTED
				}
			}
		}
	}
}
